X_BEARER_TOKEN=replace-with-your-x-api-bearer-token

# --- Notify channels (optional; enable in config.yaml notify.channels) ---

# Telegram (recommended free): talk to @BotFather → token; message your bot; get chat id via getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ntfy (recommended free push): install ntfy app, subscribe to a secret topic name
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# Twilio SMS / WhatsApp (paid). For WhatsApp use whatsapp-enabled Twilio numbers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
